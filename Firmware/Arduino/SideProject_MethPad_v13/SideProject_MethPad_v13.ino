// =========================================================================
// 🔋 電池電量偵測核心函數 (增加 BLE 動態同步通知)
// =========================================================================
void checkBattery() {
  uint32_t sum = 0;
  adcValue = 0;
  for (int i = 0; i < 16; i++) {
    sum += analogReadMilliVolts(BATTERY_PIN);
    delay(2);
  }
  adcValue = sum / 16.0;

  // 電阻 1:1 分壓還原真實電壓 (ESP32 ADC 預設最大 3.3V)
  float measuredVoltage = 2 * adcValue /1000.0;

  // 加上硬體非線性校正係數
  //measuredVoltage += 0.15; 

  // 將電壓映射為百分比：3.4V (0%) ~ 4.2V (100%)
   percentage = map(measuredVoltage * 100, 340, 420, 0, 100);
  
  if (percentage > 100) percentage = 100;
  if (percentage < 0) percentage = 0;

  batteryLevel = percentage;

  // 🔄【新增關鍵點】：如果藍牙目前處於連線狀態，則將新電量同步回傳給終端裝置
  //if (bleKeyboard.isConnected()) {
    bleKeyboard.setBatteryLevel(batteryLevel);
  //}

  Serial.print("Raw ADC: "); Serial.print(adcValue);
  Serial.print(" | Calc Voltage: "); Serial.print(measuredVoltage);
  Serial.print("V | Level: "); Serial.print(batteryLevel); Serial.println("% (Synced to BLE)");
}

// =========================================================================
// 🚀 點陣圖繪製引擎 (支援線上轉換工具)
// =========================================================================
void renderSymbolPixels(int startX, int startY, int layer, int index) {
  const uint8_t* bitmapPtr = (const uint8_t*)pgm_read_ptr(&(symbolBitmaps[layer - 1][index]));
  if (bitmapPtr == NULL) return;

  for (int y = 0; y < 16; y++) {
    uint8_t leftByte  = pgm_read_byte(bitmapPtr + (y * 2));
    uint8_t rightByte = pgm_read_byte(bitmapPtr + (y * 2) + 1);

    for (int x = 0; x < 8; x++) {
      if ((leftByte >> (7 - x)) & 0x01) {
        u8g2.drawPixel(startX + x, startY + y);
      }
    }
    for (int x = 0; x < 8; x++) {
      if ((rightByte >> (7 - x)) & 0x01) {
        u8g2.drawPixel(startX + 8 + x, startY + y);
      }
    }
  }
}

// --- Siji 狀態列 Icon ---
#define SIJI_BLUETOOTH_ON       0xE00B  
#define SIJI_BLUETOOTH_OFF      0xE02D  

void drawStatusBar(bool isConnected) {
  u8g2.setFont(u8g2_font_6x10_tf); 
  u8g2.drawStr(0, 12, "YMC-PAD");  
  u8g2.setCursor(90, 12); 
  u8g2.print(percentage);
  u8g2.print("%");

  u8g2.setFont(u8g2_font_siji_t_6x10);
  if (isConnected) {
    u8g2.drawGlyph(78, 12, SIJI_BLUETOOTH_ON);   
  } else {
    u8g2.drawGlyph(78, 12, SIJI_BLUETOOTH_OFF);  
  }

  uint16_t batteryGlyph = 0xE242; 
  if (batteryLevel >= 90 && batteryLevel <= 100)     batteryGlyph = 0xE24B;
  else if (batteryLevel >= 80 && batteryLevel < 90)  batteryGlyph = 0xE24A;
  else if (batteryLevel >= 70 && batteryLevel < 80)  batteryGlyph = 0xE249;
  else if (batteryLevel >= 60 && batteryLevel < 70)  batteryGlyph = 0xE248;
  else if (batteryLevel >= 50 && batteryLevel < 60)  batteryGlyph = 0xE247;
  else if (batteryLevel >= 40 && batteryLevel < 50)  batteryGlyph = 0xE246;
  else if (batteryLevel >= 30 && batteryLevel < 40)  batteryGlyph = 0xE245;
  else if (batteryLevel >= 20 && batteryLevel < 30)  batteryGlyph = 0xE244;
  else if (batteryLevel >= 10 && batteryLevel < 20)  batteryGlyph = 0xE243;
  else if (batteryLevel >= 0  && batteryLevel < 10)  batteryGlyph = 0xE242;
  
  u8g2.drawGlyph(114, 12, batteryGlyph); 
  u8g2.drawHLine(0, 15, 128);
}

void updateDisplay(bool isConnected) {
  u8g2.clearBuffer();
  drawStatusBar(isConnected);

  if (isConnected) {
    u8g2.setFont(u8g2_font_7x14_tf);
    u8g2.setCursor(0, 29); 
    u8g2.print("L");
    u8g2.print(currentLayer);
    u8g2.print(": ");
    u8g2.print(symbolShortcuts[currentLayer - 1][currentCursor]);

    for (int i = 0; i < 14; i++) {
      int row = i / 7;
      int col = i % 7;
      int x = col * 18;       
      int y = (row == 0) ? 33 : 49; 

      if (i == currentCursor) {
        u8g2.setDrawColor(1);
        u8g2.drawBox(x, y, 16, 16);    
        u8g2.setDrawColor(0);          
      } else {
        u8g2.setDrawColor(1);          
      }
      renderSymbolPixels(x, y, currentLayer, i);
    }
    u8g2.setDrawColor(1); 
    
  } else {
    u8g2.setFont(u8g2_font_6x12_tf);
    u8g2.drawStr(2, 38, "[ BLE Disconnected ]");
    u8g2.drawStr(6, 52, "Waiting for link...");
  }

  u8g2.sendBuffer();
}

void setup() {
  Serial.begin(57600);
  pinMode(BATTERY_PIN, INPUT);
  //analogSetAttenuation(ADC_11db);
  //analogReadResolution(12);
  
  u8g2.begin();
  u8g2.setFontMode(1);  
  u8g2.setDrawColor(1); 

  // 開機時先量測一次真實電量
  checkBattery();

  bleKeyboard.begin();
  updateDisplay(bleKeyboard.isConnected());
}

void loop() {
  bool connectedNow = bleKeyboard.isConnected();
  static bool lastConnectedState = false;
  char key = keypad.getKey();

  // 每 60 秒異步量測並同步電量一次
  if (millis() - lastBatteryCheck >= batteryInterval) {
    lastBatteryCheck = millis();
    checkBattery();
    updateDisplay(connectedNow); 
  }

  // 🔄 當連線狀態改變時（如剛連上電腦），主動觸發一次電量同步
  if (connectedNow != lastConnectedState) {
    lastConnectedState = connectedNow;
    if (connectedNow) {
      bleKeyboard.setBatteryLevel(batteryLevel); // 確保一連上就立刻將最新真實電量傳給電腦
    }
    updateDisplay(connectedNow);
  }

  if (connectedNow) {
    if (key != NO_KEY) {
      switch(key) {
        case 1: 
          currentLayer++;
          if (currentLayer > 4) currentLayer = 1;
          break;
        case 2: 
          if (currentCursor < 7) currentCursor += 7;
          break;
        case 3: 
          if (currentCursor >= 7) currentCursor -= 7;
          break;
        case 4: 
          currentCursor++;
          if (currentCursor >= 14) currentCursor = 0; 
          break;
        case 7: 
          currentCursor--;
          if (currentCursor < 0) currentCursor = 13;  
          break;
        case 8: 
          bleKeyboard.print(symbolShortcuts[currentLayer - 1][currentCursor]);
          bleKeyboard.print(" "); 
          u8g2.drawHLine(0, 16, 128); 
          u8g2.sendBuffer();
          delay(5);
          break;
        default: 
          break;
      }
      updateDisplay(true);
      //delay(20);
      bleKeyboard.releaseAll();
    }
  } else {
    static unsigned long lastTimer = 0;
    if (millis() - lastTimer > 5) {
      updateDisplay(false);臺
      lastTimer = millis();
    }
  }
}